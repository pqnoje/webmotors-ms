@gatewayUrl = http://localhost:4566/restapis/ac77m6oiiq/local/_user_request_
@usuarioId = 1

##############################################
# 👤 USUARIOS
##############################################

### LISTAR USUARIOS
GET {{gatewayUrl}}/usuarios
Accept: application/json

### CRIAR USUARIO
POST {{gatewayUrl}}/usuarios
Content-Type: application/json

{
  "nome": "Joao da Silva",
  "email": "joao.silva@example.com"
}

### DESATIVAR USUARIO
PATCH {{gatewayUrl}}/usuarios/{{usuarioId}}/desativar
Accept: application/json


##############################################
# 🚗 ANUNCIOS
##############################################

### LISTAR ANUNCIOS
GET {{gatewayUrl}}/anuncios
Accept: application/json

### CRIAR ANUNCIO
POST {{gatewayUrl}}/anuncios
Content-Type: application/json

{
  "usuarioId": {{usuarioId}},
  "marca": "Toyota",
  "modelo": "Corolla XEi",
  "ano": 2022,
  "preco": 125000.00,
  "descricao": "Veiculo em excelente estado, unico dono."
}

### LISTAR ANUNCIOS DE UM USUARIO
GET {{gatewayUrl}}/anuncios/usuario/{{usuarioId}}
Accept: application/json


##############################################
# 💳 PAGAMENTOS
##############################################

### LISTAR PAGAMENTOS
GET {{gatewayUrl}}/pagamentos
Accept: application/json

### CRIAR PAGAMENTO - PIX
POST {{gatewayUrl}}/pagamentos
Content-Type: application/json

{
  "usuarioId": {{usuarioId}},
  "amount": 150.00,
  "method": "PIX",
  "idempotencyKey": "pix-teste-001"
}

### CRIAR PAGAMENTO - BOLETO
POST {{gatewayUrl}}/pagamentos
Content-Type: application/json

{
  "usuarioId": {{usuarioId}},
  "amount": 500.00,
  "method": "BOLETO",
  "idempotencyKey": "boleto-teste-001"
}

### CRIAR PAGAMENTO - TED
POST {{gatewayUrl}}/pagamentos
Content-Type: application/json

{
  "usuarioId": {{usuarioId}},
  "amount": 2500.00,
  "method": "TED",
  "idempotencyKey": "ted-teste-001"
}
